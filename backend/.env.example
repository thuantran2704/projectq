# ============================================================
# Backend Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------
# Google Cloud Storage (GCP) Configuration
# ------------------------------------------------------------
# 1. Your Google Cloud Project ID
GCP_PROJECT_ID=my-hospital-apps-project

# 2. Your GCS Bucket Name (e.g. "my-resumes-bucket")
GCP_BUCKET_NAME=my-resumes-bucket

# 3. Path to your downloaded GCP Service Account key JSON file
# E.g. "./service-account-key.json" or "C:/keys/gcp-sa.json"
# Roles needed on the service account: "Storage Object Admin" or "Storage Object User"
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# ------------------------------------------------------------
# Email Dispatcher Configuration (Gmail / SMTP via Nodemailer)
# ------------------------------------------------------------
# For Gmail:
# - SMTP_HOST=smtp.gmail.com
# - SMTP_PORT=465 (SSL) or 587 (TLS)
# - SMTP_USER=your-email@gmail.com
# - SMTP_PASS=your-16-character-google-app-password
# (Generate App Password at: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgirlfriend@gmail.com
SMTP_PASS=abcd-efgh-ijkl-mnop

# The sender display name and email address appearing in hospital inboxes
SMTP_FROM_NAME=Your Girlfriend's Name
SMTP_FROM_EMAIL=yourgirlfriend@gmail.com

# ------------------------------------------------------------
# Optional Security
# ------------------------------------------------------------
# If set, incoming API calls must include header 'x-api-key: your-secret-key'
API_SECRET_KEY=
