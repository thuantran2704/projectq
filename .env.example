# ============================================================
# Root Environment Configuration Reference for ProjectQ
# Refer to backend/.env.example and frontend/.env.example for details
# ============================================================

# Backend Port
PORT=5000
NODE_ENV=development

# Frontend Vite Port & API Target
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=add-after-first-connect
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Cloud Platform (GCP) Configuration
# 1. Project ID from Google Cloud Console
GCP_PROJECT_ID=your-gcp-project-id

# 2. Cloud Storage Bucket Name
GCP_BUCKET_NAME=your-cloud-storage-bucket-name

# 3. Path to your downloaded GCP service account JSON key file
# E.g., C:/keys/gcp-service-account.json or relative ./service-account-key.json
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Optional: API security token for backend requests
API_SECRET_KEY=change-this-to-a-secure-random-secret

# ============================================================
# Email Configuration - Choose ONE:
# - Microsoft Graph API (Recommended for personal/work accounts)
# - SMTP (For Gmail, custom SMTP servers)
# ============================================================

# Microsoft Graph API Configuration (Azure App Registration)
# 1. Azure Application (client) ID

# 2. Azure Directory (tenant) ID

# 3. Azure Client Secret (keep this secure!)
# Generate in: Azure Portal > App Registrations > Certificates & secrets

# 4. Email address to send from (must have Graph API permissions)
# Your Microsoft/Outlook email address

# SMTP Configuration (Alternative to Graph API)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id
VITE_AZURE_CLIENT_ID=your-azure-application-client-id
VITE_AZURE_TENANT_ID=common

